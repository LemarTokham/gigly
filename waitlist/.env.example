# These are set in the Vercel dashboard (Project → Settings → Environment Variables),
# NOT committed to git. This file just documents what's needed.

# From resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# From resend.com → Audiences → (your audience) → copy the Audience ID
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Who the welcome email comes from.
# Before verifying justgigly.com in Resend, leave this unset (defaults to
# onboarding@resend.dev, which can only email your own address).
# After verifying the domain, set: "gigly <hello@justgigly.com>"
WAITLIST_FROM=gigly <hello@justgigly.com>

# Supabase — source of truth for signups + the reliable counter.
# URL: Supabase dashboard → Settings → Data API → Project URL
# SERVICE KEY: Supabase dashboard → Settings → API Keys → service_role (SECRET — server only)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...the-long-service-role-key
